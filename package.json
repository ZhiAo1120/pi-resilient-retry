{
  "name": "pi-resilient-retry",
  "version": "0.1.0",
  "description": "Keep retrying failed provider requests that Pi's built-in retry gives up on",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "retry",
    "resilience"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "files": [
    "index.ts",
    "retry-core.ts",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "check": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "typescript": "^5.6.0"
  }
}
